flowchart LR
    D["DISCOVERY\nWeek -8 to -6\nReview changelog\nCheck API deprecations\nAudit add-on versions\nReview CVEs\nCapacity planning\nStakeholder sign-off"]:::disc
    P["PREPARATION\nWeek -5 to -3\nUpdate Helm charts\nUpdate Dockerfiles\nPin add-on versions\nUpdate PDBs\nNetwork policies\nRollback plan"]:::prep
    V["VALIDATION\nWeek -2 to -1\nUpgrade staging AKS\nFull test suite\nLoad test 50% prod\nValidate monitoring\nDR rehearsal\nChange Advisory Board"]:::val
    PROD["PRODUCTION\nDeploy Day\nUpgrade control plane\nSurge node pool\nDrain old nodes\nSmoke tests\nHealth checks"]:::prod
    POST["POST-UPGRADE\n+1 to +2 Weeks\nMonitor SLOs 72h\nCheck error rates\nVerify autoscaling\nUpdate runbooks\nDelete old pool\nClose change ticket"]:::post
    D --> P --> V --> PROD --> POST
